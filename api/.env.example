DATABASE_URL="file:./store.db"
JWT_SECRET="replace-with-a-long-random-string-of-64-characters-in-production"
API_PORT=4000
WEB_URL="http://localhost:3000"

# --- Online payments (optional). Leave empty = Cash on Delivery only. Free test keys: dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to 1 when running behind a hosting proxy (Render/Railway/Nginx) so rate limits see real IPs
TRUST_PROXY=
